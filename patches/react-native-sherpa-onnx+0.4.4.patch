+++ b/node_modules/react-native-sherpa-onnx/scripts/setup-ios-framework.sh
@@ -400,6 +400,16 @@ download_and_extract_framework() {
     return 1
   fi
 
+  # focusread patch: 1.13.x ships SherpaOnnxC.framework per slice; expose it under the old names.
+  if [ "$slug" = "sherpa-onnx" ]; then
+    for slice in "$FRAMEWORKS_DIR/$XCFRAMEWORK_NAME"/ios-*; do
+      if [ -d "$slice/SherpaOnnxC.framework" ]; then
+        ln -sfn SherpaOnnxC.framework/Headers "$slice/Headers"
+        ln -sfn SherpaOnnxC.framework/SherpaOnnxC "$slice/libsherpa-onnx.a"
+      fi
+    done
+  fi
+
   if ! framework_valid "$slug" "$FRAMEWORKS_DIR/$XCFRAMEWORK_NAME"; then
     echo -e "${RED}Error: Downloaded $DISPLAY_NAME framework is missing required libraries or headers.${NC}" >&2
     echo "Expected e.g. $FRAMEWORKS_DIR/$XCFRAMEWORK_NAME/ios-arm64_x86_64-simulator/$HEADER_CHECK" >&2
